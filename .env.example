# Local mode works without an env file (password: mandarin-local-password).
# Set these for a production Vercel deploy; Blob credentials are supplied by
# the Vercel Blob store connection.
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Used only by the local Express development server.
PORT=3001
